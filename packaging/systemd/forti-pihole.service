# forti-pihole: one reconciliation run of the FortiGate device inventory (a systemd *user* unit;
# forti-pihole.timer starts it). It reads the forti home (~/.forti, or $FORTI_HOME) of the user whose
# manager runs it: device profiles and credentials (managed by `forti configure`), the engine's state
# and $FORTI_HOME/pihole/ (config.json, state.json, history.jsonl).
#
# Nothing on the network depends on this unit: when it fails or is stopped, the FortiGate keeps the
# objects it has and traffic is unaffected (fail-static). A failed run is retried by the next timer
# tick; `journalctl --user -u forti-pihole` shows why it failed.
#
# Enable for your user (never enabled by the package):
#   systemctl --user enable --now forti-pihole.timer
# For runs while you are logged out: loginctl enable-linger "$USER"
# Another forti home, profile or binary path: systemctl --user edit forti-pihole.service, e.g.
#   [Service]
#   Environment=FORTI_HOME=/srv/forti
#   ExecStart=
#   ExecStart=/usr/local/bin/forti-pihole apply --quiet --profile fw01
[Unit]
Description=Reconcile FortiGate device segments (forti-pihole apply)
Documentation=https://github.com/valkyrianlabs/forti-pihole
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/forti-pihole apply --quiet
# A stuck run (device unreachable past the engine's timeouts) must not block the next tick forever.
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle

# Hardening. Everything below is enforced with seccomp, rlimits or plain process attributes, which a
# user manager can apply without privileges. Mount-namespace options (ProtectSystem=, ProtectHome=,
# PrivateTmp=, ReadWritePaths=) are deliberately absent: in a user unit they need an unprivileged user
# namespace, which Ubuntu 24.04 restricts by default (AppArmor), and the unit would fail to start.
# The program must read and write ~/.forti anyway.
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
# HTTPS to the FortiGate (IPv4/IPv6) and local sockets (name resolution).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# Credentials and device data must never end up in a core file.
LimitCORE=0
