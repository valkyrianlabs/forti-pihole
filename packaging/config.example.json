{
  "$comment": "forti-pihole configuration. Groups are FortiGate address groups <prefix>grp-<name> (edit membership in the FortiGate GUI) mapped to Pi-hole groups. Nothing is written until enabled is true.",
  "adopt_existing": true,
  "assignments": {},
  "default_group": "default",
  "enabled": false,
  "groups": [
    {
      "description": "The operator's own devices",
      "name": "trusted",
      "privileged": true
    },
    {
      "description": "Work computers",
      "name": "work",
      "privileged": true
    },
    {
      "description": "TVs and streaming sticks",
      "name": "tvs"
    },
    {
      "description": "IoT devices with a known, needed cloud",
      "name": "iot_trusted"
    },
    {
      "description": "Commodity IoT (plugs, bulbs)",
      "name": "iot_untrusted"
    },
    {
      "description": "Everything not yet classified",
      "name": "default"
    }
  ],
  "max_changes": 50,
  "networks": [
    {
      "group": "default",
      "interface": "internal",
      "manage_reservations": false,
      "mode": "observe",
      "slices": []
    }
  ],
  "pihole": {
    "name": "default",
    "url": ""
  },
  "prefix": "fp-",
  "profile": "",
  "protected": [],
  "retire_after_days": 30,
  "rules": [
    {
      "group": "iot_untrusted",
      "match": {
        "vendor": "TP-Link"
      },
      "name": "kasa-plugs",
      "priority": 200
    },
    {
      "group": "iot_untrusted",
      "match": {
        "family": "Hue",
        "vendor": "Philips"
      },
      "name": "hue"
    },
    {
      "group": "tvs",
      "match": {
        "family": "Fire TV*",
        "vendor": "Amazon"
      },
      "name": "fire-tv"
    },
    {
      "group": "tvs",
      "match": {
        "type": "Television"
      },
      "name": "smart-tvs"
    },
    {
      "group": "iot_trusted",
      "match": {
        "vendor": "Ring"
      },
      "name": "ring"
    },
    {
      "group": "iot_trusted",
      "match": {
        "vendor": "Rain Bird"
      },
      "name": "rain-bird"
    },
    {
      "group": "iot_trusted",
      "match": {
        "vendor": "Chamberlain"
      },
      "name": "myq"
    }
  ]
}
