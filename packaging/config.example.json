{
  "$comment": "forti-vlan-mac configuration. Segments are FortiGate address groups <prefix>seg-<name>; edit membership in the FortiGate GUI.",
  "adopt_existing": true,
  "assignments": {},
  "default_segment": "default",
  "interfaces": [
    "internal"
  ],
  "max_changes": 50,
  "prefix": "mvlan-",
  "profile": "",
  "protected": [],
  "retire_after_days": 30,
  "rules": [
    {
      "match": {
        "vendor": "TP-Link"
      },
      "name": "kasa-plugs",
      "priority": 200,
      "segment": "iot_untrusted"
    },
    {
      "match": {
        "family": "Hue",
        "vendor": "Philips"
      },
      "name": "hue",
      "segment": "iot_untrusted"
    },
    {
      "match": {
        "family": "Fire TV*",
        "vendor": "Amazon"
      },
      "name": "fire-tv",
      "segment": "tvs"
    },
    {
      "match": {
        "type": "Television"
      },
      "name": "smart-tvs",
      "segment": "tvs"
    },
    {
      "match": {
        "vendor": "Ring"
      },
      "name": "ring",
      "segment": "iot_trusted"
    },
    {
      "match": {
        "vendor": "Rain Bird"
      },
      "name": "rain-bird",
      "segment": "iot_trusted"
    },
    {
      "match": {
        "vendor": "Chamberlain"
      },
      "name": "myq",
      "segment": "iot_trusted"
    }
  ],
  "segments": [
    {
      "description": "Owner's own devices",
      "name": "owner",
      "privileged": true,
      "subnet": "192.168.60.0/24"
    },
    {
      "description": "Work computers",
      "name": "work",
      "privileged": true,
      "subnet": "192.168.50.0/24"
    },
    {
      "description": "TVs and streaming sticks",
      "name": "tvs",
      "subnet": "192.168.40.0/24"
    },
    {
      "description": "IoT devices with a known, needed cloud",
      "name": "iot_trusted",
      "subnet": "192.168.31.0/24"
    },
    {
      "description": "Commodity IoT (plugs, bulbs)",
      "name": "iot_untrusted",
      "subnet": "192.168.30.0/24"
    },
    {
      "description": "Everything not yet classified (the existing 192.168.1.0/24)",
      "name": "default"
    }
  ]
}
