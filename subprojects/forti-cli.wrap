# forti-cli provides forti-engine, the command engine forti-pihole links statically. Only the
# engine is built when forti-cli is a subproject. For co-development, replace subprojects/forti-cli
# with a checkout or a symlink to ../forti-cli; Meson then uses it instead of downloading.
[wrap-git]
url = https://github.com/valkyrianlabs/forti-cli.git
# Pinned to forti-cli v0.5.0 (engine child tables), as its full commit id (package builds use
# exactly this revision; forti-mcp ships the same engine). After changing it, run `packaging/forti-cli-pin.sh update`
# (the Homebrew formula's forti-cli resource) and commit both (.claude/context/release.md, "Engine source").
revision = 6a17b34a7b8f4aaedeee33a9f4ea71a71f73f855
depth = 1

[provide]
forti-engine = forti_engine_dep
